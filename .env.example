# Google Docs integration (Viết Truyện → Google Docs).
# Without these, importing from a PUBLIC Google Docs link still works;
# pushing to Docs and opening private Docs need them.
# Setup steps: see README.md → "Cấu hình Google Docs".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
# Cloud project NUMBER (not id), used by Google Picker.
NEXT_PUBLIC_GOOGLE_APP_ID=

# Supabase (đăng nhập + đồng bộ nhiều máy). Không điền thì app chạy hoàn toàn
# trong trình duyệt như cũ. Lấy ở Supabase → Project Settings → API.
# Khóa anon là khóa công khai; phân quyền nằm ở Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
